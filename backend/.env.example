# FarmCrop backend local configuration template.
# Copy to backend/.env (git-ignored) and fill in values locally. Never commit the real file.
# Format: Java properties. Escape a literal backslash as \\ ; values are not quoted.
# Real environment variables override anything in this file.

# --- Database (local MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=farmcrop
DB_USERNAME=root
DB_PASSWORD=

# --- Authentication (milestone 2) ---
# At least 32 random bytes, base64-encoded. Generate one locally, e.g. with: openssl rand -base64 48
JWT_SECRET=

# One-time admin bootstrap (milestone 2). Used only when no admin account exists yet.
FARMCROP_ADMIN_USERNAME=
FARMCROP_ADMIN_EMAIL=
FARMCROP_ADMIN_PASSWORD=

# --- Razorpay (milestone 9) - use TEST-mode keys for development ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- AI chatbot provider (milestone 11) ---
AI_PROVIDER=
AI_PROVIDER_API_KEY=

# --- Browser origins allowed by CORS (comma separated) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
