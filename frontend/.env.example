# Copy to frontend/.env.local for local overrides (git-ignored). No secrets belong in frontend env files:
# every VITE_* value is bundled into the public JavaScript.

# Backend origin for production builds, e.g. https://api.example.com
# Leave empty in development: the Vite dev server proxies /api to DEV_API_PROXY_TARGET.
VITE_API_BASE_URL=

# Backend address used by the Vite dev proxy (dev server only, not bundled).
DEV_API_PROXY_TARGET=http://localhost:8080

# Google and phone (OTP) sign-in via Firebase Authentication. Firebase console > Project settings >
# General > Your apps > Web app config. These are public identifiers (not secrets), but restrict the API key
# to your domains in Google Cloud console. Leave empty to hide Google/phone sign-in.
# The backend needs the same project id as FIREBASE_PROJECT_ID in backend/.env.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
