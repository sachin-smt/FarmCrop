# Copy to frontend/.env.local for local overrides (git-ignored). No secrets belong in frontend env files:
# every VITE_* value is bundled into the public JavaScript.

# Backend origin for production builds, e.g. https://api.example.com
# Leave empty in development: the Vite dev server proxies /api to DEV_API_PROXY_TARGET.
VITE_API_BASE_URL=

# Backend address used by the Vite dev proxy (dev server only, not bundled).
DEV_API_PROXY_TARGET=http://localhost:8080
